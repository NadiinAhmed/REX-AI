# Copy to .env and edit. Never commit .env. All values below are safe defaults.

# ---- Course catalog: loaded into the database on first start --------------------------
REX_COURSES_PATH=data/courses_official.json      # data/courses.json = synthetic demo data

# ---- LLM: none | xai (Grok) | groq | anthropic ----------------------------------------
# "none" runs a deterministic demo with no API key. Model names change: check the console.
LLM_PROVIDER=none
LLM_MODEL=                     # empty = provider default (xai: grok-4, groq: openai/gpt-oss-120b)
XAI_API_KEY=                   # https://console.x.ai   (paid API)
GROQ_API_KEY=                  # https://console.groq.com (free tier with rate limits)
ANTHROPIC_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2

# ---- Storage --------------------------------------------------------------------------
DATABASE_URL=sqlite:///data/rex.db      # PostgreSQL later: postgresql+psycopg://user:pw@host/db
VECTOR_DIR=data/vectorstore
UPLOAD_DIR=data/uploads

# ---- RAG ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=hashing              # hashing (offline) | sentence_transformers (semantic)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.15                # re-calibrate with evaluation/ when changing the model
RETRIEVAL_KEYWORD_GATE=auto             # auto = on for hashing, off for semantic models
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=300

# ---- Integration / admin ----------------------------------------------------------------
COURSE_BACKEND=direct                   # direct | mcp (Agent 1 reads courses via the MCP server)
MCP_TIMEOUT_SECONDS=20
ADMIN_PASSWORD=                         # protects the Knowledge base and Leads pages
# ---- Agent 2: RFP research ----------------------------------------------------------------
RFP_FEED_PATH=data/rfp/sample_tenders.json   # SYNTHETIC demo feed; point to a curated export of real listings
RFP_LLM_SUMMARIES=off                        # on = the configured LLM rewrites tender summaries (facts only)
# ---- Agent 4: e-mail distribution of approved documents (leave SMTP_HOST empty = disabled) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=                                   # e.g. "Andalusia Academy <training@example.com>"
SMTP_STARTTLS=on
LOG_LEVEL=INFO

# ---- Marketing Agent (Agent 5) --------------------------------------------------------
MARKETING_MAX_ATTEMPTS=2                # LLM retries when the fact-checker blocks a draft
MARKETING_PASS_THRESHOLD=0.7            # evaluator mean for "checks passed" (calibrate with evaluation/marketing)
