# Copy to .env and edit. Never commit .env.

# Course data file (relative to the project root)
REX_COURSES_PATH=data/courses.json

# LLM: "none" = deterministic demo mode (no API key needed); "anthropic" = use Claude
LLM_PROVIDER=none
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
LLM_TIMEOUT_SECONDS=30

LOG_LEVEL=INFO
