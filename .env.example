# Copy to .env and edit. Never commit .env. All values below are safe defaults.

# ---- Course catalog: loaded into the database on first start --------------------------
REX_COURSES_PATH=data/courses_official.json      # data/courses.json = synthetic demo data

# ---- LLM: none | xai (Grok) | groq | anthropic ----------------------------------------
# "none" runs a deterministic demo with no API key. Model names change: check the console.
LLM_PROVIDER=none
LLM_MODEL=                     # empty = provider default (xai: grok-4, groq: openai/gpt-oss-120b)
XAI_API_KEY=                   # https://console.x.ai   (paid API)
GROQ_API_KEY=                  # https://console.groq.com (free tier with rate limits)
ANTHROPIC_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2
LLM_REASONING_EFFORT=low              # gpt-oss models on Groq only: low = fastest; medium/high think longer

# ---- Storage --------------------------------------------------------------------------
DATABASE_URL=sqlite:///data/rex.db      # PostgreSQL later: postgresql+psycopg://user:pw@host/db
VECTOR_DIR=data/vectorstore
UPLOAD_DIR=data/uploads

# ---- RAG ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=hashing              # hashing (offline) | sentence_transformers (semantic)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.15                # re-calibrate with evaluation/ when changing the model
RETRIEVAL_KEYWORD_GATE=auto             # auto = on for hashing, off for semantic models
# Course recommendations: keyword (exact words) | semantic (meaning, needs EMBEDDING_PROVIDER=sentence_transformers)
COURSE_RETRIEVER=keyword
COURSE_SEMANTIC_MIN_SCORE=0.84          # measured for multilingual-e5-small; re-scan if you change EMBEDDING_MODEL
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=300

# ---- Integration / admin ----------------------------------------------------------------
COURSE_BACKEND=direct                   # direct | mcp (Agent 1 reads courses via the MCP server)
MCP_TIMEOUT_SECONDS=20
ADMIN_PASSWORD=                         # protects the Knowledge base and Leads pages
# ---- Agent 2: RFP research ----------------------------------------------------------------
RFP_SOURCES=worldbank,etimad,ungm           # live, real tenders: worldbank = World Bank API (Egypt), etimad = Saudi gov portal, ungm = UN Global Marketplace (Egypt + Saudi). Add ,file for the SYNTHETIC demo feed
RFP_FEED_PATH=data/rfp/sample_tenders.json   # SYNTHETIC demo feed (only read when RFP_SOURCES includes file)
RFP_MAX_PAGES=3                              # result pages read per search on Etimad / UNGM
RFP_WORLDBANK_ROWS=100                       # newest notices read per country per scan
RFP_HTTP_TIMEOUT_SECONDS=20
RFP_AI=auto                                  # LLM review of near-misses + notice analysis: auto (on if an LLM is set) | on | off
RFP_LLM_SUMMARIES=auto                       # LLM summaries of new tenders: auto | on | off
RFP_AI_MAX_CALLS=20                          # LLM calls per scan for review + analysis
# ---- Agent 4: e-mail distribution of approved documents (leave SMTP_HOST empty = disabled) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=                                   # e.g. "Andalusia Academy <training@example.com>"
SMTP_STARTTLS=on

# ---- Agent 5: sending APPROVED marketing drafts (Approved tab -> "Send this draft") ----
MARKETING_DELIVERY_MODE=dry_run              # dry_run = check + log only, nothing sent; live = really send
LINKEDIN_ACCESS_TOKEN=                       # OAuth token with w_member_social (developer app: "Share on LinkedIn")
LINKEDIN_AUTHOR_URN=                         # urn:li:person:<id>  (company page: urn:li:organization:<id>)
LINKEDIN_API_VERSION=                        # YYYYMM; empty = a recent active version is chosen automatically
# E-mail drafts use the SMTP_* settings above (Gmail: smtp.gmail.com, port 587, an App Password).
LOG_LEVEL=INFO

# ---- Marketing Agent (Agent 5) --------------------------------------------------------
MARKETING_MAX_ATTEMPTS=2                # LLM retries when the fact-checker blocks a draft
MARKETING_PASS_THRESHOLD=0.7            # evaluator mean for "checks passed" (calibrate with evaluation/marketing)
